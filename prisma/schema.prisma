generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id         Int      @id @default(autoincrement())
  title      String
  desciption String
  githubUrl  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  userId     String

  user User @relation(fields: [userId], references: [id])
}

model Notes {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id])
}

model Snippet {
  id         Int      @id @default(autoincrement())
  title      String
  code       String
  language   String
  desciption String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  userId     String

  user User @relation(fields: [userId], references: [id])
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String?
  createdAt DateTime
  updatedAt DateTime @updatedAt

  projects Project[]
  notes    Notes[]
  snippets Snippet[]
}